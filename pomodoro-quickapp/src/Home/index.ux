<template>
  <div class="page">
    <text class="mode" style="color:{{ modeColor }}">{{ modeName }}</text>
    <text class="clock">{{ clockText }}</text>
    <text class="round">ROUND {{ round }}</text>
    <div class="bar">
      <div class="fill" style="width:{{ fillPct }}px; background-color:{{ modeColor }}"></div>
    </div>
    <div class="btnrow">
      <div class="btn" onclick="onReset"><text class="btntext">重置</text></div>
      <div class="btn btn-primary" onclick="onToggle"><text class="btntext">{{ runBtn }}</text></div>
    </div>
    <text class="hint" onclick="onAbout">关于 ›</text>
  </div>
</template>

<script>
const PHASES = [
  { key: 'focus', ms: 25 * 60 * 1000, name: '专注', color: '#e05252' },
  { key: 'break', ms: 5 * 60 * 1000, name: '休息', color: '#35c28f' },
  { key: 'long', ms: 15 * 60 * 1000, name: '长休息', color: '#3a8dd6' }
]

export default {
  private: {
    modeName: '专注',
    modeColor: '#e05252',
    clockText: '25:00',
    round: 0,
    fillPct: 0,
    runBtn: '开始',
    running: false,
    phaseIdx: 0,
    remainingMs: 25 * 60 * 1000,
    tickTimer: null
  },

  onInit() {
    this.render()
  },

  onShow() {
    // re-render on resume; timer only runs while page is visible
    this.render()
  },

  onHide() {
    this.pause()
  },

  onDestroy() {
    this.pause()
  },

  onBackPress() {
    // allow back navigation
    return false
  },

  startTick() {
    const self = this
    if (this.tickTimer) return
    this.tickTimer = setInterval(function () { self.onTick() }, 250)
  },

  pause() {
    if (this.tickTimer) {
      clearInterval(this.tickTimer)
      this.tickTimer = null
    }
    this.running = false
    this.runBtn = '开始'
  },

  onTick() {
    const now = Date.now()
    this.remainingMs -= (now - (this.lastTick || now))
    this.lastTick = now
    if (this.remainingMs <= 0) {
      this.advancePhase(true)
    }
    this.render()
  },

  advancePhase(finished) {
    const idx = this.phaseIdx
    if (idx === 0) {
      // focus ended -> break or long break every 4 rounds
      this.round = this.round + 1
      this.phaseIdx = (this.round % 4 === 0) ? 2 : 1
    } else {
      this.phaseIdx = 0
    }
    this.remainingMs = PHASES[this.phaseIdx].ms
    this.vibrate(PHASES[this.phaseIdx].key === 'focus' ? 180 : 400)
  },

  onToggle() {
    if (this.running) {
      this.pause()
    } else {
      this.running = true
      this.runBtn = '暂停'
      this.lastTick = Date.now()
      this.startTick()
    }
  },

  onReset() {
    this.pause()
    this.phaseIdx = 0
    this.remainingMs = PHASES[0].ms
    this.render()
  },

  onAbout() {
    this.$router.push({ path: 'About' })
  },

  vibrate(ms) {
    try {
      this.$app.$def && null
      const vibrator = require('@system.vibrator')
      vibrator.vibrate({ mode: 'long' })
    } catch (e) {
      // vibrator unavailable on some builds
    }
  },

  render() {
    const p = PHASES[this.phaseIdx]
    const ms = Math.max(0, this.remainingMs)
    const totalSec = Math.round(ms / 1000)
    const mm = Math.floor(totalSec / 60)
    const ss = totalSec % 60
    this.modeName = p.name
    this.modeColor = p.color
    this.clockText = (mm < 10 ? '0' : '') + mm + ':' + (ss < 10 ? '0' : '') + ss
    const ratio = 1 - ms / p.ms
    this.fillPct = Math.round(120 * Math.min(1, Math.max(0, ratio)))
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  background-color: #0b0e14;
  width: 168px;
  height: 240px;
}
.mode {
  margin-top: 18px;
  font-size: 16px;
  color: #e05252;
}
.clock {
  margin-top: 6px;
  font-size: 42px;
  color: #eaf1f8;
}
.round {
  margin-top: 2px;
  font-size: 12px;
  color: #8fa3bd;
}
.bar {
  margin-top: 10px;
  width: 120px;
  height: 4px;
  border-radius: 2px;
  background-color: #27303f;
}
.fill {
  height: 4px;
  border-radius: 2px;
  background-color: #e05252;
}
.btnrow {
  margin-top: 14px;
  flex-direction: row;
  justify-content: space-between;
  width: 140px;
}
.btn {
  width: 64px;
  height: 26px;
  border-radius: 13px;
  background-color: #27303f;
  align-items: center;
  justify-content: center;
}
.btn-primary {
  background-color: #e05252;
}
.btntext {
  font-size: 13px;
  color: #ffffff;
}
.hint {
  margin-top: 10px;
  font-size: 11px;
  color: #8fa3bd;
}
</style>
